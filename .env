# Frontend
FRONTEND_PORT_INTERNAL=3000


# Backend
BACKEND_PORT_INTERNAL=8080
SECRET_KEY="InsanelySecretKey"
ALGORITHM=HS256
PROJECT_NAME="Hell App"
BACKEND_CORS_ORIGINS=["http://localhost"]
BACKEND_DEBUG=true
DOMAIN="localhost"
ACCESS_TOKEN_EXPIRE_SECONDS=36000


# Admin user
ADMIN_EMAIL="admin@hell-app.com"
ADMIN_PASSWORD="AdminSecret11"

# Test users, leave them empty if you don't want to use them.
STUDENT_EMAIL="Student123@hell-app.com"
STUDENT_PASSWORD="StudentSecret11"

TEACHER_EMAIL="Teacher123@hell-app.com"
TEACHER_PASSWORD="TeacherSecret11"

# Paths
# Those paths will be used to generate the URLs in emails. You can change them however you want.
# Links will be generated like this: https://{DOMAIN}{PATH}, so make sure to include the leading slash.
LOGIN_PATH="/login"
VERIFY_MAIL_PATH="/verify"
# Keep {id} or {token} in the path, it will be replaced with the actual data from backend API.
# You can change the order of the path, for example: /auth/{token}/password-reset/hello/world
PASSWORD_RESET_PATH="/password-reset/{token}"
DELETE_ACCOUNT_PATH="/delete-account/{token}"
MFA_DISABLE_RECOVERY_PATH="/mfa/disable-recovery/{token}"
EXAM_INSTANCE_PATH="/exams/{id}"
DASHBOARD_PATH="/dashboard"



# Email (Mailhog)
SMTP_USER="test@test.com"
SMTP_PASSWORD="password"
EMAILS_FROM_EMAIL="test@out.com"
SMTP_PORT=1025
SMTP_HOST="mailhog"
EMAIL_FROM_NAME="No reply"


# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
MONGO_INITDB_DATABASE=app

MONGO_PORT_INTERNAL=27017
MONGO_PORT=27017
MONGO_HOST=mongodb


# NGINX
HTTP_PORT=80
HTTPS_PORT=443


# Redis
REDIS_HOST=redis
REDIS_PORT_INTERNAL=6379


# Flover
FLOWER_PORT_INTERNAL=5555


# Mailhog
MAILHOG_UI_PORT_INTERNAL=8025
MAILHOG_PORT_INTERNAL=1025
MAILHOG_PORT=1025


# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_PORT_INTERNAL=9000
MINIO_CONSOLE_PORT=9001
MINIO_CONSOLE_PORT_INTERNAL=9001
MINIO_BROWSER_REDIRECT_URL=http://localhost/dev/minio
MINIO_DOMAIN=localhost/dev/minio

# MinIO Storage Configuration
MINIO_ENDPOINT=minio1:9000
MINIO_EXTERNAL_ENDPOINT=localhost
MINIO_SECURE=false
MINIO_BUCKET_NAME=hell-app-files
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost/minio

# Upload Limits (in MB)
MAX_UPLOAD_SIZE_MB=10
MAX_PROFILE_PICTURE_SIZE_MB=2
MAX_LANDMARK_IMAGE_SIZE_MB=10
MAX_UNLOCK_PHOTO_SIZE_MB=15

# Allowed File Types
ALLOWED_IMAGE_EXTENSIONS=["jpg", "jpeg", "png", "webp"]
ALLOWED_MIME_TYPES=["image/jpeg", "image/png", "image/webp"]

# Storage URL Expiry (in seconds)
# 1 hour and 7 days respectively
STORAGE_URL_DEFAULT_EXPIRY_SECONDS=3600
STORAGE_URL_MAX_EXPIRY_SECONDS=604800

# Image Processing Settings
IMAGE_THUMBNAIL_SIZE=[300, 300]
IMAGE_MAX_DIMENSION=2048
IMAGE_QUALITY=85